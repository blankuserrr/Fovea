{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [],
    "contact": {
        "homepage": "https://github.com/blankuserrr/Fovea",
        "sources": "https://github.com/blankuserrr/Fovea"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.fovea.Fovea"
        ],
        "sodium:config_api_user": [
            "com.fovea.compat.sodium.FoveaSodiumConfig"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "sodium": ">=0.9.0"
    }
}
  
